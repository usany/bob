# Crontab file for Django project
# Format: * * * * * command
# - - - - -
# | | | | |
# | | | | +----- Day of week (0-7, Sunday=0 or 7)
# | | | +------- Month (1-12)
# | | +--------- Day of month (1-31)
# | +----------- Hour (0-23)
# +------------- Minute (0-59)

# Example: Run Django management command daily at midnight
# 0 0 * * * cd /path/to/project && /path/to/venv/bin/python manage.py your_command

# Example: Run backup daily at 2 AM
# 0 2 * * * cd /path/to/project && /path/to/venv/bin/python manage.py backup

# Example: Clear expired sessions daily at 3 AM
# 0 3 * * * cd /path/to/project && /path/to/venv/bin/python manage.py clearsessions

# Example: Send email digest every Monday at 9 AM
# 0 9 * * 1 cd /path/to/project && /path/to/venv/bin/python manage.py send_email_digest

# Example: Run custom command every hour
# 0 * * * * cd /path/to/project && /path/to/venv/bin/python manage.py your_hourly_task

# Example: Run database maintenance weekly on Sunday at 4 AM
# 0 4 * * 0 cd /path/to/project && /path/to/venv/bin/python manage.py db_maintenance

# NOTE: Replace /path/to/project with your actual project path
# NOTE: Replace /path/to/venv/bin/python with your virtual environment python path
# NOTE: Uncomment and customize the entries you need
